{
  "$schema": "https://raw.githubusercontent.com/revisit-studies/study/v2.4.4/src/parser/StudyConfigSchema.json",
  "studyMetadata": {
    "title": "Document Review (test harness)",
    "version": "test",
    "authors": [
      "WPI VIS"
    ],
    "date": "2026-09-16",
    "description": "The document-review stimulus on its own, with audio and screen recording turned off. demo-document-review gates its first task behind the screen-recording permission component, which needs real screen capture and detected sound and so cannot be driven by Playwright. This config exercises the same component without that gate.",
    "organizations": [
      "WPI"
    ]
  },
  "uiConfig": {
    "contactEmail": "contact@revisit.dev",
    "helpTextPath": "demo-document-review/assets/introduction.md",
    "logoPath": "revisitAssets/revisitLogoSquare.svg",
    "withProgressBar": true,
    "autoDownloadStudy": false,
    "withSidebar": true,
    "sidebarWidth": 320
  },
  "baseComponents": {
    "documentReview": {
      "type": "react-component",
      "path": "demo-document-review/assets/DocumentReviewTask.tsx",
      "nextButtonLocation": "sidebar",
      "instructionLocation": "sidebar",
      "response": [
        {
          "id": "flaggedClauses",
          "prompt": "Clauses you flagged",
          "location": "sidebar",
          "type": "reactive"
        },
        {
          "id": "clauseNotes",
          "prompt": "Your notes",
          "location": "sidebar",
          "type": "reactive"
        }
      ]
    }
  },
  "components": {
    "review-nda": {
      "baseComponent": "documentReview",
      "description": "Review of a mutual NDA sent on the counterparty's paper.",
      "instruction": "Flag any clause that concerns you.",
      "parameters": {
        "documentId": "mutual-nda",
        "dwellMs": 200,
        "paneHeight": 400
      }
    },
    "review-msa": {
      "baseComponent": "documentReview",
      "description": "Review of a vendor-form SaaS master services agreement.",
      "instruction": "Flag any clause that concerns you.",
      "parameters": {
        "documentId": "saas-msa",
        "dwellMs": 200,
        "paneHeight": 400
      }
    }
  },
  "sequence": {
    "order": "fixed",
    "components": [
      "review-nda",
      "review-msa"
    ]
  }
}
